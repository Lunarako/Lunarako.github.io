# Copy this file to .env to try the contribution calendar locally. Never commit .env.

# A GitHub token for the contribution calendar (GraphQL needs one).
# A fine-grained token with no permissions is enough. Without it the calendar is empty in a local build.
# The deploy workflow sets GITHUB_TOKEN for you, so you do not need this on GitHub.
# GITHUB_TOKEN=

# Optional, in the repo's Settings > Secrets and variables > Actions:
# CONTRIBUTIONS_TOKEN=   # your own token: the calendar then counts your private contributions too
